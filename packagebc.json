{
  "name": "bridge-constructor",
  "version": "0.1.0",
  "description": "Single-level browser game: build bridges across a canyon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:playwright": "playwright test",
    "test:ci": "npm run type-check && npm run lint && npm run test && npm run test:playwright && npm run build"
  },
  "dependencies": {
    "pixi.js": "^8.4.0",
    "planck-js": "^0.3.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/ui": "^1.6.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
